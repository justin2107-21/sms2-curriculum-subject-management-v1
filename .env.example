# Set these as runtime environment variables in Apache/PHP. Never commit real values.
CIMF_AI_ENABLED=false
CIMF_AI_PROVIDER=groq
CIMF_AI_MODEL=openai/gpt-oss-120b
GROQ_API_KEY=
OPENAI_API_KEY=
# Optional provider-specific model overrides; blank uses CIMF_AI_MODEL.
CIMF_GROQ_MODEL=
CIMF_OPENAI_MODEL=

# Offering API: keyed-hash pepper for API client keys (at least 32 random characters). Required to create or use API keys.
API_KEY_PEPPER=
# Optional: requests per minute per API client (default 60).
API_RATE_LIMIT_PER_MIN=
