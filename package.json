{
  "name": "csms-sms2-ui",
  "private": true,
  "description": "Dev-only UI build tooling. Production serves the compiled files in assets/ui/dist.",
  "scripts": {
    "build:css": "sass --style=compressed --no-source-map --quiet --load-path=node_modules assets/ui/scss/csms-bootstrap.scss assets/ui/dist/css/csms-bootstrap.css",
    "build:assets": "node tools/ui/copy-vendor.cjs",
    "build": "npm run build:css && npm run build:assets"
  },
  "devDependencies": {
    "@fontsource-variable/dm-sans": "5.3.0",
    "@fontsource-variable/newsreader": "5.3.0",
    "bootstrap": "~5.3.0",
    "bootstrap-icons": "^1.11.0",
    "chart.js": "4.6.1",
    "sass": "^1.80.0"
  }
}
