# Allow only application source/assets and controlled CLI migration files.
**
!Dockerfile
!.dockerignore
!.htaccess
!index.php
!health.php
!students.sql
!admin/
!admin/**
!api/
!api/**
!assets/
!assets/ui/
!assets/ui/dist/
!assets/ui/dist/**
!auth/
!auth/**
!css/
!css/**
!dashboard/
!dashboard/**
!home_tab/
!home_tab/**
!images/
!images/**
!js/
!lib/
!lib/PHPMailer/
!lib/PHPMailer/*.php
!js/**
!modules/
!modules/**
!reports_tab/
!reports_tab/**
!shared/
!shared/**
!database/
!database/*.php
!database/migrations/
!database/migrations/*.sql
!docker/
!docker/**

# Defense in depth even within an allowed directory.
**/.git
**/.github
**/.agents
**/.codex
**/.vscode
**/.idea
**/.env
**/.env.*
**/*.log
**/*.bak
**/*.dump
**/*.sql.gz
**/*backup*.sql
**/*.cookie
**/*.cookies
**/cookies*.txt
**/sess_*
**/node_modules
**/config/local.php
**/config/*.local.php
**/config/secrets.php
database/seeds
!database/seeds/
!database/seeds/bsit_dataset.php
!database/seeds/bsit_preoral_manifest.json
tests
docs
tmp
temp
backups

# Only reviewed schema SQL belongs in an image, never arbitrary nested dumps.
**/*.sql
!students.sql
!database/migrations/*.sql
**/*.zip
**/*.tar
**/*.gz
**/*.7z
**/*.pem
**/*.key
**/*.p12
**/*.pfx
