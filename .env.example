# CSMS-SMS2 environment variables. Names and placeholders only: never commit real values.
# There is NO .env loader: the app reads real environment variables (getenv). Set them in the
# Hostforge panel (container environment), or with SetEnv / the web server for a non-Docker host.

# --- Mode -------------------------------------------------------------------------------------
# production makes the app refuse to start its database connection with a localhost host, the
# root user, an empty password or no database name ("Production database configuration is required.").
# The Dockerfile already sets APP_ENV=production.
APP_ENV=production

# --- Database (MariaDB 10.4 or newer, a separate service) -------------------------------------
# Host name of the database service as seen from the app container (not localhost).
DB_HOST=your-mariadb-service-name
DB_PORT=3306
# The database (schema) that holds the imported data.
DB_NAME=sms_db
# A dedicated application user, not root.
DB_USER=csms_app
# Required in production. Set it in the panel; never put the real value in this file.
DB_PASS=set-in-the-hosting-panel

# --- Sessions and HTTPS -----------------------------------------------------------------------
# 1 = session cookie always has the Secure flag (required behind an HTTPS proxy that terminates TLS;
# the Dockerfile already sets 1). Use 0 only for an isolated local HTTP test.
SMS_SESSION_COOKIE_SECURE=1
# Port Apache listens on inside the container (Dockerfile default 8080).
PORT=8080
# Must stay 0 on a host: it would enable the development setup page.
SMS_ALLOW_SETUP=0

# --- Access scope -----------------------------------------------------------------------------
# What Acad Faculty may read: active_or_approved (default) or approved. Unknown values use the stricter approved.
CSMS_FACULTY_READ_SCOPE=active_or_approved
# Optional: 0 hides the pending dashboard charts.
CSMS_DASHBOARD_SHOW_PENDING_CHARTS=

# --- Offering API -----------------------------------------------------------------------------
# Keyed-hash pepper for API client keys (at least 32 random characters). Required to create or use API keys.
# The same value must be used wherever the keys were created (local and host), or existing keys stop working.
# User passwords do NOT use a pepper (plain password_hash), so imported password hashes work on any host.
API_KEY_PEPPER=
# Optional: requests per minute per API client (default 60, maximum 1000).
API_RATE_LIMIT_PER_MIN=

# --- CIMF AI advice (optional; off by default) ------------------------------------------------
CIMF_AI_ENABLED=false
CIMF_AI_PROVIDER=groq
CIMF_AI_MODEL=openai/gpt-oss-120b
# Only the key of the chosen provider is needed. Leave blank to keep AI off.
GROQ_API_KEY=
OPENAI_API_KEY=
# Optional provider-specific model overrides; blank uses CIMF_AI_MODEL.
CIMF_GROQ_MODEL=
CIMF_OPENAI_MODEL=

# --- Email OTP at sign-in (optional; off by default) ------------------------------------------
# OTP_ENABLED=1 makes sign-in ask for a 6-digit code sent to the user's email after the password. Empty or 0 = off, sign-in is unchanged.
# Accounts without a valid email address still sign in with the password only. With OTP_ENABLED=1 and SMTP not working, nobody with an email can sign in (the code cannot be sent).
# Run migration 033 first (database/deploy.php). Mail is sent with PHPMailer (lib/PHPMailer).
OTP_ENABLED=
# SMTP server of your mail provider.
SMTP_HOST=
# 587 (STARTTLS, default when empty) or 465 (SSL).
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
# From address (a real mailbox your provider allows) and the display name in the inbox.
SMTP_FROM=
SMTP_FROM_NAME=

# --- Operator-only, one-time (leave unset in normal running) ----------------------------------
# CSMS_RUN_MIGRATIONS=1 with CSMS_MIGRATION_CONFIRM_DATABASE=<DB_NAME> runs pending migrations at container start.
# CSMS_BOOTSTRAP_ADMIN=1 with CSMS_ADMIN_* creates the first administrator once. Remove them afterwards.
