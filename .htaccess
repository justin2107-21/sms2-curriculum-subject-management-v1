# The project is served directly by local XAMPP. Never serve repository,
# database, test, or local configuration artifacts as public downloads.
Options -Indexes
RewriteEngine On
RewriteRule (^|/)(\.git|\.agents|\.codex|\.github|\.vscode|\.idea)(/|$) - [F,L,NC]
RewriteRule ^(database|tests|docs|docker|config|storage|tmp|temp|logs|backups|scripts)(/|$) - [F,L,NC]
# Machine API: pretty URL, and keep the Authorization header (FastCGI drops it otherwise).
RewriteRule ^api/v1/offerings/?$ api/v1/offerings.php [L,QSA]
SetEnvIf Authorization "(.+)" HTTP_AUTHORIZATION=$1
<FilesMatch "(?i)(\.(sql|log|ini|bak|dump|cookie|cookies)(\.(gz|zip))?$|^\.env(?:\..*)?$|^Dockerfile$|^\.dockerignore$)">
    Require all denied
</FilesMatch>
